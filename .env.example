# Copy to .env. Values marked "generated" are created by scripts/bootstrap.sh.
LITELLM_MASTER_KEY=sk-change-me            # echo "sk-$(openssl rand -hex 24)"
OPEN_TERMINAL_API_KEY=change-me            # openssl rand -hex 24

# Provider key, created inside the dedicated "openwebui" workspace in console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Open WebUI admin API key (Admin Panel → Settings → General → Enable API Keys; then Settings → Account → API Keys)
OPENWEBUI_ADMIN_API_KEY=sk-...

# generated
POSTGRES_PASSWORD=
LITELLM_DB_PASSWORD=
LITELLM_UI_PASSWORD=
OPENWEBUI_LITELLM_KEY=
